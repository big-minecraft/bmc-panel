{
  "environment": "development",
  "namespace": "bmc",

  "certManager": {
    "clusterIssuerName": "letsencrypt-staging",
    "email": "your-email@example.com",
    "installClusterIssuer": true
  },

  "panel": {
    "initialInviteCode": "your-invite-code",
    "panelSecret": "your-secret-key",
    "storagePath": "/data",
    "panelHost": "localhost",
    "inviteCodeExpiryDays": 7
  },

  "oidc": {
    "enabled": false,
    "displayName": "authentik",

    "issuer": "https://auth.example.com/application/o/bmc-panel/",
    "clientId": "your-client-id",
    "clientSecret": "your-client-secret",
    "redirectUri": "https://panel.example.com/api/auth/oidc/callback",

    "scopes": "openid profile email groups",

    "allowedGroup": "bmc-panel-users",
    "adminGroup": "bmc-panel-admins",
    "autoCreateUsers": true,

    "allowLocalLogin": true,
    "endSessionOnLogout": false
  },

  "edge": {
    "game": {
      "type": "LoadBalancer",
      "loadBalancerIP": "192.168.1.100",
      "java": {
        "port": 25565
      },
      "bedrock": {
        "enabled": false,
        "port": 19132
      }
    },
    "file": {
      "type": "LoadBalancer"
    }
  },

  "metallb": {
    "installResources": true,
    "advertisementMode": "l2",
    "ipAddressPool": [
      "192.168.1.100/32"
    ]
  },

  "ingress": {
    "className": "traefik",
    "host": "panel.example.com",
    "tls": {
      "mode": "cluster-issuer",
      "issuer": "letsencrypt-staging"
    }
  },

  "storage": {
    "classes": {
      "shared": {
        "name": "local-path",
        "accessMode": "ReadWriteOnce"
      },
      "database": {
        "name": "local-path",
        "accessMode": "ReadWriteOnce"
      }
    },
    "volumeSize": {
      "persistent": "10Gi",
      "scalable": "5Gi",
      "proxy": "5Gi",
      "process": "2Gi",
      "manifests": "1Gi",
      "mariaDB": "5Gi",
      "mongoDB": "5Gi"
    }
  },

  "redis": {
    "host": "redis-service",
    "port": 6379
  },

  "mariaDB": {
    "host": "mariadb-service",
    "port": 3306,
    "username": "root",
    "initPassword": "your-mariadb-password",
    "database": "bmc"
  },

  "mongoDB": {
    "host": "mongodb-service",
    "port": 27017,
    "username": "admin",
    "initPassword": "your-mongodb-password",
    "database": "admin"
  },

  "prometheus": {
    "host": "prometheus-service",
    "port": 9090
  },

  "fileEditSession": {
    "timeoutMinutes": 15,
    "maxUploadMb": 4096,
    "maxEditorFileMb": 4
  },

  "sftp": {
    "enabled": true,
    "password": "your-sftp-password",
    "passwordAuth": true
  }
}
